# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.secret
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml

# SSH / TLS key material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_ed25519
id_ecdsa
*.pub

# AWS / cloud credentials
.aws/credentials
.aws/config
*.aws_credentials
gcp-credentials.json
service-account*.json

# Claude / IDE local settings
.claude/settings.local.json

