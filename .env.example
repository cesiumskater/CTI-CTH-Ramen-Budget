# Ramen CVE configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# NVD API key (free, optional but strongly recommended)
# Without a key: 5 requests per 30 seconds (~6s between calls)
# With a key:    50 requests per 30 seconds (~0.6s between calls)
# Request one here: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GitHub personal access token (free, optional)
# Used by the exploit/PoC tracker to query the GitHub Search API.
# Without a token: GitHub PoC search is silently skipped.
# With a token:    rate limit is 30 req/min instead of 10. No scopes required;
#                  the default "public" access is enough.
# Create one here: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Per-source IOC enrichment API keys. All optional; missing keys cause the
# matching enricher to be skipped silently. MalwareBazaar (abuse.ch) is open
# and requires no key.
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# AbuseIPDB:  https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=

# Dispatch destinations (only used when ramen_cve is invoked with --dispatch).
# Both are optional; missing values cause the matching dispatcher to be skipped.
# SLACK_WEBHOOK_URL: an Incoming Webhook URL from a Slack app
#   (https://api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=
# RAMEN_DISPATCH_WEBHOOK: any URL that accepts a POST with a JSON body shaped
# like the EnrichedCve summary (see GenericWebhookDispatcher in ramen_cve.py).
RAMEN_DISPATCH_WEBHOOK=

# Daily-digest email (only used when ramen_cve is invoked with --digest).
# RAMEN_SMTP_HOST + RAMEN_SMTP_FROM are required; the rest are optional.
# The digest groups kev_override / patch_now CVEs by the inventory CSV's
# `owner` column (one email per owner), with the CSV + Markdown attached.
# RAMEN_DIGEST_TO catches CVEs whose affected hosts have no explicit owner.
RAMEN_SMTP_HOST=
RAMEN_SMTP_PORT=587
RAMEN_SMTP_USER=
RAMEN_SMTP_PASS=
RAMEN_SMTP_FROM=
RAMEN_SMTP_USE_TLS=1
RAMEN_DIGEST_TO=

# Cache settings (optional — defaults are fine for most users)
RAMEN_CACHE_PATH=.ramen-cache.db
RAMEN_CACHE_TTL_HOURS=24

# Logging level (optional: DEBUG, INFO, WARNING, ERROR; default INFO)
RAMEN_LOG_LEVEL=INFO
